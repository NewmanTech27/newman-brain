filters:
  and:
    - 'type == "entity"'
properties:
  note.title:
    displayName: Nombre completo
  note.updated:
    displayName: Actualizada
  note.tags:
    displayName: Etiquetas
views:
  - type: table
    name: Todas
    order:
      - file.name
      - title
      - tags
      - updated
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Clientes
    filters:
      or:
        - 'file.hasTag("cliente")'
        - 'file.hasTag("client")'
    order:
      - file.name
      - title
      - updated
    sort:
      - property: updated
        direction: DESC
